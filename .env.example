# VisionX Environment Configuration
# Copy to .env and fill values

# Database
DATABASE_URL=postgresql://visionx:visionx@postgres:5432/visionx
POSTGRES_USER=visionx
POSTGRES_PASSWORD=visionx
POSTGRES_DB=visionx

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Storage
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm,video/avi

# Models & API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_TOKEN=
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=visionx

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# Processing
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
YOLO_MODEL=yolov8n.pt
FRAME_SAMPLE_FPS=1.0
SCENE_THRESHOLD=30.0

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Object Storage (optional S3 compatible)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=visionx
